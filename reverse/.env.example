# Copy this file to the repository root as .env, then fill in your own key.
# Never commit .env or include it in generated records.

# Official Moonshot / Kimi OpenAI-compatible API
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Or use any OpenAI-compatible provider instead of the Kimi variables above.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Optional request timeout in seconds.
CONSTRUCT_API_TIMEOUT=120
