n  color: #198754;\n  border-color: #198754;\n}\n</style>\n<script>\n(function() {\n  const uploadZone = document.getElementById('upload-zone');\n  const fileInput = document.getElementById('file-input');\n  const fileQueue = document.getElementById('file-queue');\n  let fileIdCounter = 0;\n  const activeUploads = new Map();\n\n  uploadZone.addEventListener('click', () => fileInput.click());\n  uploadZone.addEventListener('dragover', (e) => {\n    e.preventDefault();\n    uploadZone.classList.add('dragover');\n  });\n  uploadZone.addEventListener('dragleave', () => {\n    uploadZone.classList.remove('dragover');\n  });\n  uploadZone.addEventListener('drop', (e) => {\n    e.preventDefault();\n    uploadZone.classList.remove('dragover');\n    handleFiles(e.dataTransfer.files);\n  });\n  fileInput.addEventListener('change', (e) => {\n    handleFiles(e.target.files);\n    fileInput.value = '';\n  });\n\n  function handleFiles(files) {\n    for (const file of files) {\n      addFileToQueue(file);\n    }\n  }\n\n  function getFileIcon(type) {\n    if (type.startsWith('image/')) return null;\n    if (type.includes('pdf')) return '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"/><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"/></svg>';\n    if (type.includes('zip') || type.includes('compressed')) return '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"/></svg>';\n    return '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/></svg>';\n  }\n\n  function addFileToQueue(file) {\n    const id = ++fileIdCounter;\n    const isImage = file.type.startsWith('image/');\n    const item = document.createElement('div');\n    item.className = 'file-item';\n    item.id = 'file-' + id;\n\n    const previewHtml = isImage\n      ? '<img src=\"' + URL.createObjectURL(file) + '\" alt=\"\">'\n      : getFileIcon(file.type);\n\n    item.innerHTML = `\n      <div class=\"file-preview\" id=\"preview-${id}\">${previewHtml}</div>\n      <div class=\"file-info\">\n        <div class=\"file-name\">${escapeHtml(file.name)}</div>\n        <div class=\"file-progress\">\n          <div class=\"file-progress-bar\" id=\"progress-${id}\"></div>\n        </div>\n      </div>\n      <div class=\"file-percent\" id=\"percent-${id}\">0%</div>\n      <div class=\"file-actions\">\n        <button class=\"btn-cancel\" id=\"cancel-${id}\">Cancel</button>\n        <button class=\"btn-remove\" id=\"remove-${id}\" style=\"display:none\">Remove</button>\n      </div>\n    `;\n\n    fileQueue.appendChild(item);\n\n    const cancelBtn = document.getElementById('cancel-' + id);\n    const removeBtn = document.getElementById('remove-' + id);\n\n    cancelBtn.addEventListener('click', () => cancelUpload(id));\n    removeBtn.addEventListener('click', () => removeFile(id));\n\n    simulateUpload(id, file);\n  }\n\n  function simulateUpload(id, file) {\n    let progress = 0;\n    const progressBar = document.getElementById('progress-' + id);\n    const percentEl = document.getElementById('percent-' + id);\n    const cancelBtn = document.getElementById('cancel-' + id);\n    const removeBtn = document.getElementById('remove-' + id);\n\n    const interval = setInterval(() => {\n      progress += Math.random() * 15 + 5;\n      if (progress >= 100) {\n        progress = 100;\n        clearInterval(interval);\n        progressBar.classList.add('complete');\n        cancelBtn.style.display = 'none';\n        removeBtn.style.display = '';\n      }\n      progressBar.style.width = progress + '%';\n      percentEl.textContent = Math.round(progress) + '%';\n    }, 300);\n\n    activeUploads.set(id, { interval, cancelled: false });\n  }\n\n  function cancelUpload(id) {\n    const upload = activeUploads.get(id);\n    if (!upload) return;\n    upload.cancelled = true;\n    clearInterval(upload.interval);\n    const progressBar = document.getElementById('progress-' + id);\n    const percentEl = document.getElementById('percent-' + id);\n    const cancelBtn = document.getElementById('cancel-' + id);\n    const removeBtn = document.getElementById('remove-' + id);\n    progressBar.classList.add('cancelled');\n    percentEl.textContent = 'Cancelled';\n    cancelBtn.style.display = 'none';\n    removeBtn.style.display = '';\n    activeUploads.delete(id);\n  }\n\n  function removeFile(id) {\n    const item = document.getElementById('file-' + id);\n    if (item) item.remove();\n    activeUploads.delete(id);\n  }\n\n  function escapeHtml(text) {\n    const div = document.createElement('div');\n    div.textContent = text;\n    return div.innerHTML;\n  }\n})();\n</script>\n</body>\n</html>"
    }
