{
  "llm_raw_response": "<description>\n[\n  {\"task_type\": \"File Upload with Progress\", \"description\": \"Add a file upload section to the About page where users can drag and drop or click to browse for files, see image thumbnails or file icons, track upload progress with percentage bars, and manage multiple files with cancel and remove options.\"}\n]\n</description>\n\n<search_replace path=\"about.html\">\n<search>\n<div class=\"jumbotron jumbotron-internal p-5 mb-4 text-center\">\n<div class=\"container\">\n<h1 class=\"display-5 fw-bold\">About Perl</h1>\n<p class=\"col-md-8 fs-4 mx-auto\">What is Perl? Features and History.</p>\n</div>\n</div>\n</search>\n<replace>\n<div class=\"jumbotron jumbotron-internal p-5 mb-4 text-center\">\n<div class=\"container\">\n<h1 class=\"display-5 fw-bold\">About Perl</h1>\n<p class=\"col-md-8 fs-4 mx-auto\">What is Perl? Features and History.</p>\n</div>\n</div>\n</search>\n<replace>\n<div class=\"jumbotron jumbotron-internal p-5 mb-4 text-center\">\n<div class=\"container\">\n<h1 class=\"display-5 fw-bold\">About Perl</h1>\n<p class=\"col-md-8 fs-4 mx-auto\">What is Perl? Features and History.</p>\n</div>\n</div>\n<div class=\"container mb-5\">\n  <div class=\"row\">\n    <div class=\"col-12\">\n      <h3 class=\"mb-3\">Upload Your Perl Resources</h3>\n      <div id=\"upload-zone\" class=\"upload-zone p-4 text-center\">\n        <div class=\"upload-prompt\">\n          <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"mb-2\">\n            <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/>\n            <polyline points=\"17 8 12 3 7 8\"/>\n            <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"/>\n          </svg>\n          <p class=\"mb-1\">Drag and drop files here, or <span class=\"upload-browse\">click to browse</span></p>\n          <p class=\"text-muted small\">Supports images, documents, and archives</p>\n        </div>\n        <input type=\"file\" id=\"file-input\" multiple accept=\"*/*\" style=\"display:none\">\n      </div>\n      <div id=\"file-queue\" class=\"file-queue mt-3\"></div>\n    </div>\n  </div>\n</div>\n</replace>\n</search_replace>\n\n<search_replace path=\"about.html\">\n<search>\n</body>\n</html>\n</search>\n<replace>\n<style>\n.upload-zone {\n  border: 2px dashed #6c757d;\n  border-radius: 8px;\n  background: #f8f9fa;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n.upload-zone:hover, .upload-zone.dragover {\n  border-color: #198754;\n  background: #e8f5e9;\n}\n.upload-browse {\n  color: #198754;\n  text-decoration: underline;\n}\n.file-item {\n  display: flex;\n  align-items: center;\n  padding: 12px;\n  border: 1px solid #dee2e6;\n  border-radius: 6px;\n  margin-bottom: 8px;\n  background: #fff;\n}\n.file-preview {\n  width: 48px;\n  height: 48px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-right: 12px;\n  flex-shrink: 0;\n}\n.file-preview img {\n  max-width: 100%;\n  max-height: 100%;\n  border-radius: 4px;\n  object-fit: cover;\n}\n.file-preview svg {\n  width: 32px;\n  height: 32px;\n  color: #6c757d;\n}\n.file-info {\n  flex: 1;\n  min-width: 0;\n}\n.file-name {\n  font-weight: 500;\n  margin-bottom: 4px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.file-progress {\n  height: 6px;\n  background: #e9ecef;\n  border-radius: 3px;\n  overflow: hidden;\n}\n.file-progress-bar {\n  height: 100%;\n  background: #198754;\n  border-radius: 3px;\n  transition: width 0.3s ease;\n  width: 0%;\n}\n.file-progress-bar.cancelled {\n  background: #dc3545;\n}\n.file-progress-bar.complete {\n  background: #198754;\n}\n.file-percent {\n  font-size: 12px;\n  color: #6c757d;\n  margin-left: 8px;\n  min-width: 40px;\n  text-align: right;\n}\n.file-actions {\n  display: flex;\n  gap: 8px;\n  margin-left: 12px;\n}\n.file-actions button {\n  padding: 4px 12px;\n  font-size: 12px;\n  border: 1px solid #dee2e6;\n  border-radius: 4px;\n  background: #fff;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n.file-actions button:hover {\n  background: #f8f9fa;\n}\n.file-actions .btn-cancel {\n  color: #dc3545;\n  border-color: #dc3545;\n}\n.file-actions .btn-remove {\n  color: #6c757d;\n}\n.file-actions .btn-retry {\n  color: #198754;\n  border-color: #198754;\n}\n</style>\n<script>\n(function() {\n  const uploadZone = document.getElementById('upload-zone');\n  const fileInput = document.getElementById('file-input');\n  const fileQueue = document.getElementById('file-queue');\n  let fileIdCounter = 0;\n  const activeUploads = new Map();\n\n  uploadZone.addEventListener('click', () => fileInput.click());\n  uploadZone.addEventListener('dragover', (e) => {\n    e.preventDefault();\n    uploadZone.classList.add('dragover');\n  });\n  uploadZone.addEventListener('dragleave', () => {\n    uploadZone.classList.remove('dragover');\n  });\n  uploadZone.addEventListener('drop', (e) => {\n    e.preventDefault();\n    uploadZone.classList.remove('dragover');\n    handleFiles(e.dataTransfer.files);\n  });\n  fileInput.addEventListener('change', (e) => {\n    handleFiles(e.target.files);\n    fileInput.value = '';\n  });\n\n  function handleFiles(files) {\n    for (const file of files) {\n      addFileToQueue(file);\n    }\n  }\n\n  function getFileIcon(type) {\n    if (type.startsWith('image/')) return null;\n    if (type.includes('pdf')) return '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"/><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"/></svg>';\n    if (type.includes('zip') || type.includes('compressed')) return '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"/></svg>';\n    return '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/></svg>';\n  }\n\n  function addFileToQueue(file) {\n    const id = ++fileIdCounter;\n    const isImage = file.type.startsWith('image/');\n    const item = document.createElement('div');\n    item.className = 'file-item';\n    item.id = 'file-' + id;\n\n    const previewHtml = isImage\n      ? '<img src=\"' + URL.createObjectURL(file) + '\" alt=\"\">'\n      : getFileIcon(file.type);\n\n    item.innerHTML = `\n      <div class=\"file-preview\" id=\"preview-${id}\">${previewHtml}</div>\n      <div class=\"file-info\">\n        <div class=\"file-name\">${escapeHtml(file.name)}</div>\n        <div class=\"file-progress\">\n          <div class=\"file-progress-bar\" id=\"progress-${id}\"></div>\n        </div>\n      </div>\n      <div class=\"file-percent\" id=\"percent-${id}\">0%</div>\n      <div class=\"file-actions\">\n        <button class=\"btn-cancel\" id=\"cancel-${id}\">Cancel</button>\n        <button class=\"btn-remove\" id=\"remove-${id}\" style=\"display:none\">Remove</button>\n      </div>\n    `;\n\n    fileQueue.appendChild(item);\n\n    const cancelBtn = document.getElementById('cancel-' + id);\n    const removeBtn = document.getElementById('remove-' + id);\n\n    cancelBtn.addEventListener('click', () => cancelUpload(id));\n    removeBtn.addEventListener('click', () => removeFile(id));\n\n    simulateUpload(id, file);\n  }\n\n  function simulateUpload(id, file) {\n    let progress = 0;\n    const progressBar = document.getElementById('progress-' + id);\n    const percentEl = document.getElementById('percent-' + id);\n    const cancelBtn = document.getElementById('cancel-' + id);\n    const removeBtn = document.getElementById('remove-' + id);\n\n    const interval = setInterval(() => {\n      progress += Math.random() * 15 + 5;\n      if (progress >= 100) {\n        progress = 100;\n        clearInterval(interval);\n        progressBar.classList.add('complete');\n        cancelBtn.style.display = 'none';\n        removeBtn.style.display = '';\n      }\n      progressBar.style.width = progress + '%';\n      percentEl.textContent = Math.round(progress) + '%';\n    }, 300);\n\n    activeUploads.set(id, { interval, cancelled: false });\n  }\n\n  function cancelUpload(id) {\n    const upload = activeUploads.get(id);\n    if (!upload) return;\n    upload.cancelled = true;\n    clearInterval(upload.interval);\n    const progressBar = document.getElementById('progress-' + id);\n    const percentEl = document.getElementById('percent-' + id);\n    const cancelBtn = document.getElementById('cancel-' + id);\n    const removeBtn = document.getElementById('remove-' + id);\n    progressBar.classList.add('cancelled');\n    percentEl.textContent = 'Cancelled';\n    cancelBtn.style.display = 'none';\n    removeBtn.style.display = '';\n    activeUploads.delete(id);\n  }\n\n  function removeFile(id) {\n    const item = document.getElementById('file-' + id);\n    if (item) item.remove();\n    activeUploads.delete(id);\n  }\n\n  function escapeHtml(text) {\n    const div = document.createElement('div');\n    div.textContent = text;\n    return div.innerHTML;\n  }\n})();\n</script>\n</body>\n</html>\n</replace>\n</search_replace>",
