: inline-block;\n    }\n    .file-item.completed .progress-fill {\n      background-color: #4a4;\n    }\n    .file-item.error .progress-fill {\n      background-color: #c44;\n    }\n</style>\n<script>\n(function() {\n  const dropZone = document.getElementById('drop-zone');\n  const fileInput = document.getElementById('file-input');\n  const fileQueue = document.getElementById('file-queue');\n  let uploads = new Map();\n\n  dropZone.addEventListener('click', () => fileInput.click());\n  dropZone.addEventListener('dragover', (e) => {\n    e.preventDefault();\n    dropZone.classList.add('dragover');\n  });\n  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));\n  dropZone.addEventListener('drop', (e) => {\n    e.preventDefault();\n    dropZone.classList.remove('dragover');\n    handleFiles(e.dataTransfer.files);\n  });\n  fileInput.addEventListener('change', (e) => {\n    handleFiles(e.target.files);\n    fileInput.value = '';\n  });\n\n  function handleFiles(files) {\n    for (const file of files) {\n      addFileToQueue(file);\n    }\n  }\n\n  function formatBytes(bytes) {\n    if (bytes === 0) return '0 Bytes';\n    const k = 1024;\n    const sizes = ['Bytes', 'KB', 'MB', 'GB'];\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];\n  }\n\n  function getFileIcon(file) {\n    if (file.type.startsWith('image/')) {\n      return '<span class=\"file-icon\">🖼️</span>';\n    }\n    const ext = file.name.split('.').pop().toLowerCase();\n    const icons = {\n      pdf: '📄', doc: '📝', docx: '📝', txt: '📃',\n      zip: '📦', rar: '📦', '7z': '',\n      mp3: '🎵', mp4: '🎬', avi: '🎬',\n      js: '💻', html: '🌐', css: '🎨', json: '📋'\n    };\n    return '<span class=\"file-icon\">' + (icons[ext] || '📎') + '</span>';\n  }\n\n  function addFileToQueue(file) {\n    const id = 'upload-' + Date.now() + '-' + Math.random().toString(36).substr(2, 9);\n    const item = document.createElement('div');\n    item.className = 'file-item';\n    item.id = id;\n    item.dataset.filename = file.name;\n\n    const isImage = file.type.startsWith('image/');\n    const previewHtml = isImage ? '<img src=\"\" alt=\"\"/>' : getFileIcon(file);\n\n    item.innerHTML = \n      '<div class=\"file-preview\" id=\"preview-' + id + '\">' + previewHtml + '</div>' +\n      '<div class=\"file-info\">' +\n        '<div class=\"file-name\">' + escapeHtml(file.name) + '</div>' +\n        '<div class=\"file-size\">' + formatBytes(file.size) + '</div>' +\n        '<div class=\"progress-bar\"><div class=\"progress-fill\" id=\"progress-' + id + '\"></div></div>' +\n        '<div class=\"progress-text\" id=\"text-' + id + '\">0%</div>' +\n      '</div>' +\n      '<div class=\"file-actions\">' +\n        '<button class=\"cancel-btn\" id=\"cancel-' + id + '\">Cancel</button>' +\n        '<button class=\"remove-btn\" id=\"remove-' + id + '\">Remove</button>' +\n      '</div>';\n\n    fileQueue.appendChild(item);\n\n    if (isImage) {\n      const reader = new FileReader();\n      reader.onload = (e) => {\n        const img = item.querySelector('.file-preview img');\n        if (img) img.src = e.target.result;\n      };\n      reader.readAsDataURL(file);\n    }\n\n    document.getElementById('cancel-' + id).addEventListener('click', () => cancelUpload(id));\n    document.getElementById('remove-' + id).addEventListener('click', () => removeFile(id));\n\n    startUpload(id, file);\n  }\n\n  function escapeHtml(text) {\n    const div = document.createElement('div');\n    div.textContent = text;\n    return div.innerHTML;\n  }\n\n  function startUpload(id, file) {\n    const item = document.getElementById(id);\n    item.classList.add('uploading');\n\n    const xhr = new XMLHttpRequest();\n    const controller = { aborted: false, xhr: xhr };\n    uploads.set(id, controller);\n\n    const formData = new FormData();\n    formData.append('file', file);\n\n    xhr.upload.addEventListener('progress', (e) => {\n      if (e.lengthComputable) {\n        const percent = Math.round((e.loaded / e.total) * 100);\n        updateProgress(id, percent);\n      }\n    });\n\n    xhr.addEventListener('load', () => {\n      if (controller.aborted) return;\n      const item = document.getElementById(id);\n      item.classList.remove('uploading');\n      item.classList.add('completed');\n      updateProgress(id, 100);\n      document.getElementById('text-' + id).textContent = 'Complete';\n      uploads.delete(id);\n    });\n\n    xhr.addEventListener('error', () => {\n      if (controller.aborted) return;\n      const item = document.getElementById(id);\n      item.classList.remove('uploading');\n      item.classList.add('error');\n      document.getElementById('text-' + id).textContent = 'Error';\n      uploads.delete(id);\n    });\n\n    xhr.addEventListener('abort', () => {\n      const item = document.getElementById(id);\n      item.classList.remove('uploading');\n      item.classList.add('error');\n      document.getElementById('text-' + id).textContent = 'Cancelled';\n      uploads.delete(id);\n    });\n\n    // Simulate upload with mock delay\n    const mockUpload = () => {\n      let progress = 0;\n      const interval = setInterval(() => {\n        if (controller.aborted) {\n          clearInterval(interval);\n          return;\n        }\n        progress += Math.random() * 15;\n        if (progress >= 100) {\n          progress = 100;\n          clearInterval(interval);\n          xhr.dispatchEvent(new Event('load'));\n        } else {\n          updateProgress(id, Math.round(progress));\n        }\n      }, 200 + Math.random() * 300);\n    };\n\n    // In a real scenario, use: xhr.open('POST', '/upload'); xhr.send(formData);\n    // Here we simulate the upload\n    mockUpload();\n  }\n\n  function updateProgress(id, percent) {\n    const fill = document.getElementById('progress-' + id);\n    const text = document.getElementById('text-' + id);\n    if (fill) fill.style.width = percent + '%';\n    if (text) text.textContent = percent + '%';\n  }\n\n  function cancelUpload(id) {\n    const controller = uploads.get(id);\n    if (controller) {\n      controller.aborted = true;\n      if (controller.xhr) controller.xhr.abort();\n    }\n    const item = document.getElementById(id);\n    if (item) {\n      item.classList.remove('uploading');\n      item.classList.add('error');\n      document.getElementById('text-' + id).textContent = 'Cancelled';\n    }\n    uploads.delete(id);\n  }\n\n  function removeFile(id) {\n    const item = document.getElementById(id);\n    if (item) {\n      cancelUpload(id);\n      item.remove();\n    }\n  }\n})();\n</script></body></html>\n</replace>\n</search_replace>",
