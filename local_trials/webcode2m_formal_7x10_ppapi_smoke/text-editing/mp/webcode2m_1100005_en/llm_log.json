teUpload(id);\n  }\n\n  function simulateUpload(id) {\n    const upload = uploads.get(id);\n    if (!upload) return;\n\n    const progressFill = document.getElementById(id + '-progress');\n    const status = document.getElementById(id + '-status');\n    const cancelBtn = document.getElementById(id + '-cancel');\n    let progress = 0;\n\n    status.textContent = 'Uploading...';\n\n    upload.interval = setInterval(() => {\n      if (upload.cancelled) {\n        clearInterval(upload.interval);\n        return;\n      }\n\n      progress += Math.random() * 15 + 5;\n      if (progress >= 100) {\n        progress = 100;\n        clearInterval(upload.interval);\n        progressFill.classList.add('complete');\n        status.textContent = 'Complete';\n        cancelBtn.disabled = true;\n      }\n\n      progressFill.style.width = progress + '%';\n      progressFill.textContent = Math.floor(progress) + '%';\n    }, 300);\n  }\n\n  window.cancelUpload = function(id) {\n    const upload = uploads.get(id);\n    if (!upload || upload.cancelled) return;\n\n    upload.cancelled = true;\n    if (upload.interval) clearInterval(upload.interval);\n\n    const progressFill = document.getElementById(id + '-progress');\n    const status = document.getElementById(id + '-status');\n    const cancelBtn = document.getElementById(id + '-cancel');\n\n    progressFill.classList.add('cancelled');\n    progressFill.textContent = 'Cancelled';\n    status.textContent = 'Cancelled';\n    cancelBtn.disabled = true;\n  };\n\n  window.removeFile = function(id) {\n    const upload = uploads.get(id);\n    if (upload) {\n      upload.cancelled = true;\n      if (upload.interval) clearInterval(upload.interval);\n      uploads.delete(id);\n    }\n    const item = document.getElementById(id);\n    if (item) item.remove();\n  };\n})();\n</script></body></html>\n</search>\n</search_replace>",
