 0, 0.2, 1) forwards;\n}\n\n.page-transition-slide::view-transition-new(root) {\n  animation: slide-in-right 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;\n}\n\n.page-transition-slide-reverse::view-transition-old(root) {\n  animation: slide-out-right 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;\n}\n\n.page-transition-slide-reverse::view-transition-new(root) {\n  animation: slide-in-left 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;\n}\n\n/* Zoom transition */\n.page-transition-zoom::view-transition-old(root) {\n  animation: zoom-out 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;\n}\n\n.page-transition-zoom::view-transition-new(root) {\n  animation: zoom-in 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;\n}\n\n/* Flip transition */\n.page-transition-flip::view-transition-old(root) {\n  animation: flip-out 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;\n}\n\n.page-transition-flip::view-transition-new(root) {\n  animation: flip-in 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;\n}\n\n@keyframes fade-out {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n@keyframes fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes slide-out-left {\n  from { transform: translateX(0); opacity: 1; }\n  to { transform: translateX(-30%); opacity: 0; }\n}\n\n@keyframes slide-in-right {\n  from { transform: translateX(30%); opacity: 0; }\n  to { transform: translateX(0); opacity: 1; }\n}\n\n@keyframes slide-out-right {\n  from { transform: translateX(0); opacity: 1; }\n  to { transform: translateX(30%); opacity: 0; }\n}\n\n@keyframes slide-in-left {\n  from { transform: translateX(-30%); opacity: 0; }\n  to { transform: translateX(0); opacity: 1; }\n}\n\n@keyframes zoom-out {\n  from { transform: scale(1); opacity: 1; }\n  to { transform: scale(0.8); opacity: 0; }\n}\n\n@keyframes zoom-in {\n  from { transform: scale(1.2); opacity: 0; }\n  to { transform: scale(1); opacity: 1; }\n}\n\n@keyframes flip-out {\n  from { transform: perspective(800px) rotateY(0deg); opacity: 1; }\n  to { transform: perspective(800px) rotateY(-90deg); opacity: 0; }\n}\n\n@keyframes flip-in {\n  from { transform: perspective(800px) rotateY(90deg); opacity: 0; }\n  to { transform: perspective(800px) rotateY(0deg); opacity: 1; }\n}\n\n/* Loading overlay */\n.page-loading-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(255, 255, 255, 0.95);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 9999;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 0.3s ease;\n}\n\n.page-loading-overlay.active {\n  opacity: 1;\n  pointer-events: all;\n}\n\n.page-loading-spinner {\n  width: 48px;\n  height: 48px;\n  border: 4px solid #e6e6e6;\n  border-top-color: #005a9c;\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n}\n\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n\n/* Fallback for browsers without View Transitions API */\n@supports not (view-transition-name: none) {\n  .page-transition-fade {\n    animation: fade-in 0.4s ease;\n  }\n}\n</style>\n</head>\n<body class=\"home\" data-cleaned-by=\"webcode2m-format-utils\">\n<div class=\"page-loading-overlay\" id=\"page-loading-overlay\">\n  <div class=\"page-loading-spinner\"></div>\n</div>\n<a class=\"skip-link\">Skip to content</a>\n<div class=\"grid-wrap\">\n<div class=\"wrap\">\n<header class=\"global-header\">\n<span></span>\n<nav id=\"lang-nav\">\n<div class=\"l-center\">\n<div class=\"l-cluster\">\n<ul class=\"clean-list\">\n<li><a href=\"ja.html\" data-transition=\"slide\" data-transition-reverse=\"slide-reverse\">日本語ホームページ<span class=\"visuallyhidden\">Japanese website</span></a></li>\n<li><a href=\"zh-hans.html\" data-transition=\"zoom\" data-transition-reverse=\"zoom\">简体中文首页<span class=\"visuallyhidden\">Chinese website</span></a></li>\n</ul>\n</div>\n</div>\n</nav>\n</search>\n</search_replace>\n\n<search_replace path=\"index.html\">\n<search>\n</body>\n</html>\n</search>\n<replace>\n<script>\n(function() {\n  'use strict';\n  \n  // Transition manager for page navigation\n  const transitionManager = {\n    currentTransition: null,\n    isNavigating: false,\n    \n    // Get transition type based on navigation direction\n    getTransitionType(link, isBack) {\n      const transitionAttr = isBack ? 'data-transition-reverse' : 'data-transition';\n      return link.getAttribute(transitionAttr) || link.getAttribute('data-transition') || 'fade';\n    },\n    \n    // Apply transition class to document\n    setTransitionClass(transitionType, isReverse) {\n      const prefix = 'page-transition-';\n      const suffix = isReverse ? '-reverse' : '';\n      document.documentElement.className = document.documentElement.className\n        .replace(/page-transition-\\w+(-reverse)?/g, '')\n        .trim();\n      document.documentElement.classList.add(`${prefix}${transitionType}${suffix}`);\n    },\n    \n    // Show loading overlay\n    showLoading() {\n      const overlay = document.getElementById('page-loading-overlay');\n      if (overlay) overlay.classList.add('active');\n    },\n    \n    // Hide loading overlay\n    hideLoading() {\n      const overlay = document.getElementById('page-loading-overlay');\n      if (overlay) overlay.classList.remove('active');\n    },\n    \n    // Navigate with transition\n    async navigate(href, transitionType, isReverse) {\n      if (this.isNavigating) return;\n      this.isNavigating = true;\n      \n      this.setTransitionClass(transitionType, isReverse);\n      \n      // Store transition info for back/forward handling\n      sessionStorage.setItem('lastTransitionType', transitionType);\n      sessionStorage.setItem('lastTransitionReverse', isReverse ? 'true' : 'false');\n      \n      if (document.startViewTransition) {\n        const transition = document.startViewTransition(() => {\n          this.showLoading();\n          window.location.href = href;\n        });\n        \n        try {\n          await transition.finished;\n        } catch (e) {\n          // Transition interrupted or failed, navigate directly\n          window.location.href = href;\n        }\n      } else {\n        // Fallback for browsers without View Transitions API\n        this.showLoading();\n        setTimeout(() => {\n          window.location.href = href;\n        }, 150);\n      }\n    }\n  };\n  \n  // Handle language link clicks\n  document.querySelectorAll('#lang-nav a[href]').forEach(link => {\n    link.addEventListener('click', function(e) {\n      e.preventDefault();\n      const href = this.getAttribute('href');\n      const transitionType = transitionManager.getTransitionType(this, false);\n      transitionManager.navigate(href, transitionType, false);\n    });\n  });\n  \n  // Handle browser back/forward buttons\n  window.addEventListener('pageshow', function(e) {\n    if (e.persisted) {\n      // Page was loaded from bfcache, hide loading\n      transitionManager.hideLoading();\n      transitionManager.isNavigating = false;\n    }\n  });\n  \n  // Check for reverse transition on page load (back button)\n  (function checkReverseTransition() {\n    const lastType = sessionStorage.getItem('lastTransitionType');\n    const lastReverse = sessionStorage.getItem('lastTransitionReverse');\n    \n    if (lastType && lastReverse === 'true') {\n      // Apply reverse transition on entry\n      transitionManager.setTransitionClass(lastType, true);\n    }\n    \n    // Clear stored transition after applying\n    sessionStorage.removeItem('lastTransitionType');\n    sessionStorage.removeItem('lastTransitionReverse');\n  })();\n  \n  // Hide loading when page is fully loaded\n  window.addEventListener('load', function() {\n    transitionManager.hideLoading();\n    transitionManager.isNavigating = false;\n  });\n  \n})();\n</script>\n</body>\n</html>\n</replace>\n</search_replace>\n\n<search_replace path=\"ja.html\">\n<search>\n<!DOCTYPE html>\n\n<html class=\"no-js\">\n<head>\n<title>W3C</title>\n<link/>\n<link/>\n